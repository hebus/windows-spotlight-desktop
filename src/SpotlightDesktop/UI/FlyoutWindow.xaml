<Window x:Class="SpotlightDesktop.UI.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Spotlight Desktop"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="340"
        MouseEnter="OnMouseEnter"
        MouseLeave="OnMouseLeave">
    <Border CornerRadius="12" Background="#F2202020" Padding="16">
        <StackPanel>
            <Border CornerRadius="8" ClipToBounds="True">
                <Image Source="{Binding ThumbnailSource}" Height="140" Stretch="UniformToFill"/>
            </Border>
            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="White"
                       Margin="0,10,0,4" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#CCCCCC"
                       TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Copyright}" FontSize="10" Foreground="#999999" Margin="0,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Je n'aime pas" Command="{Binding DislikeCommand}" Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="J'aime" Command="{Binding LikeCommand}" Padding="8,4" Margin="0,0,8,0"/>
                <Button Content="Suivant" Command="{Binding NextCommand}" Padding="8,4"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
